# Copy to .env.test.local and fill in. NEVER commit .env.test.local.
# Everything here points at the TEST Supabase project ("action-test"), never
# production. npm run seed, npm test and npm run test:e2e load this file only,
# and refuse to run without it (outside CI).

# TEST project URL.
# Dashboard → action-test → Project Settings → Data API → Project URL
# (or the "Connect" button at the top of the project → App Frameworks).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-TEST-PROJECT.supabase.co

# TEST project PUBLIC (publishable / anon) key.
# Dashboard → action-test → Project Settings → API Keys → Publishable key
# (or the "Legacy API Keys" tab → anon public).
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_or_anon_key

# TEST project SECRET (service-role) key. Used only by scripts/seed.ts.
# Dashboard → action-test → Project Settings → API Keys → Secret keys → reveal
# (or the "Legacy API Keys" tab → service_role).
SUPABASE_SECRET_KEY=sb_secret_key

# TEST project Postgres connection string, Session pooler, with the password
# filled in. Used with psql to apply the baseline schema and SQL changes.
# Dashboard → action-test → "Connect" button at the top → Connection String →
# Method: Session pooler → copy the URI and replace [YOUR-PASSWORD].
# Forgot the password? Project Settings → Database → Reset database password.
TEST_DB_URL=postgresql://postgres.YOUR-TEST-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Shared password for the TEST project's seed accounts. Not a dashboard value:
# generate it with `openssl rand -hex 20` (at least 20 characters).
SEED_PASSWORD=replace-with-a-long-random-value

# Password for seed-admin-1@actionseed.test in the TEST project. Not a dashboard
# value: generate it with `openssl rand -hex 20`.
SEED_ADMIN_PASSWORD=replace-with-a-long-random-value

# scripts/seed.ts refuses to run unless this is exactly "true". Only this file
# sets it, so npm run seed can't be pointed at production by accident.
SEED_ALLOWED=true
