# Copy to .env.local and fill in. NEVER commit .env.local.
# The app and the seed script already use the first three; the tests add SEED_PASSWORD.

# Supabase project URL and PUBLIC (publishable / anon) key — safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_or_anon_key

# Supabase SECRET (service-role) key. Used ONLY by scripts/seed.ts (server-side,
# bypasses RLS). NEVER imported by app/ or by the tests.
SUPABASE_SECRET_KEY=sb_secret_key

# Shared password for the seed accounts (seed-<key>@actionseed.test). Must match
# SHARED_PASSWORD in scripts/seed.ts. The RLS tests sign in with this — anon key
# only, never the secret key.
SEED_PASSWORD=ActionSeed!2026
