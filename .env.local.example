# Copy to .env.local and fill in. NEVER commit .env.local.
# The app uses the first two; the seed scripts also use the secret key and SEED_PASSWORD;
# the tests use the first two and SEED_PASSWORD.

# Supabase project URL and PUBLIC (publishable / anon) key — safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_or_anon_key

# Supabase SECRET (service-role) key. Used ONLY by scripts/seed.ts (server-side,
# bypasses RLS). NEVER imported by app/ or by the tests.
SUPABASE_SECRET_KEY=sb_secret_key

# Shared password for the seed accounts (seed-<key>@actionseed.test). This is the
# single source: scripts/seed.ts, scripts/rotate-seed-passwords.ts and the tests
# all read it (the tests sign in with the anon key only, never the secret key).
# At least 20 characters — generate one with: openssl rand -hex 20
# CI reads it from the SEED_PASSWORD repo secret. Never commit the real value.
SEED_PASSWORD=replace-with-a-long-random-value

# Password for seed-admin-1@actionseed.test (is_admin = true). Deliberately NOT
# the shared seed password: seed accounts share a project with real users, so
# this is a real admin login — use a strong, unique value and never commit it.
# Leave empty to skip the seed admin; the admin RLS tests then skip visibly.
SEED_ADMIN_PASSWORD=
