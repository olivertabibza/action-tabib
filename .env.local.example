# Copy to .env.local and fill in. NEVER commit .env.local.
# This file points at PRODUCTION. The app uses the first two; only
# npm run seed:rotate-passwords also uses the secret key and SEED_PASSWORD.
# npm run seed, npm test and npm run test:e2e never read this file: they use
# .env.test.local (the TEST project; see .env.test.local.example).

# Supabase project URL and PUBLIC (publishable / anon) key — safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_or_anon_key

# Supabase SECRET (service-role) key. Used ONLY by
# scripts/rotate-seed-passwords.ts (server-side, bypasses RLS). NEVER imported by
# app/ or by the tests.
SUPABASE_SECRET_KEY=sb_secret_key

# Shared password for PRODUCTION's existing seed accounts
# (seed-<key>@actionseed.test). Only npm run seed:rotate-passwords reads it here.
# The test project's seed accounts have their own SEED_PASSWORD in
# .env.test.local, and CI's SEED_PASSWORD secret is the test project's value.
# At least 20 characters — generate one with: openssl rand -hex 20
# Never commit the real value.
SEED_PASSWORD=replace-with-a-long-random-value

# Password for production's seed-admin-1@actionseed.test (is_admin = true). No
# script reads it from this file any more (the seed and the tests use
# .env.test.local); keep it only as your record of that production login, which
# is a real admin on the live site. Never commit it.
SEED_ADMIN_PASSWORD=
